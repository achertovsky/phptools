{
    "name": "achertovsky/phptools",
    "version": "0.8.0",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.0",
        "squizlabs/php_codesniffer": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpmd/phpmd": "^2.0",
        "povils/phpmnd": "^3.5",
        "achertovsky/phpdrc": "^0.3.1",
        "phpunit/phpunit": "^13",
        "infection/infection": "^0.34"
    },
    "bin": [
        "phpcpdrun",
        "phpmndrun",
        "suggest-config",
        "phptools",
        "phpcpd"
    ],
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
